<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_arm">
  <!-- Kinematics only. ros2_control (mock or ESP32) is added by
       my_arm_moveit_config/config/my_arm.ros2_control.xacro -->

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="orange">
    <color rgba="1 0.5 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>
  </link>

  <link name="link_2">
    <visual>
      <geometry>
        <cylinder length="0.405" radius="0.025"/>
      </geometry>
      <origin xyz="0 0 0.2025" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.405" radius="0.025"/>
      </geometry>
      <origin xyz="0 0 0.2025" rpy="0 0 0"/>
    </collision>
  </link>

  <link name="link_3">
    <visual>
      <geometry>
        <cylinder length="0.345" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 0.1725" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.345" radius="0.015"/>
      </geometry>
      <origin xyz="0 0 0.1725" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Tip of the forearm (no wrist yet). Used as the end effector for IK / Servo. -->
  <link name="ee_link"/>

  <joint name="joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="1.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.221730" effort="200" velocity="0.3"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.405" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.792527" upper="0.0" effort="100" velocity="0.3"/>
  </joint>

  <joint name="ee_joint" type="fixed">
    <parent link="link_3"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.345" rpy="0 0 0"/>
  </joint>

</robot>